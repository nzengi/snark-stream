+                ss_rss_mb()
+            );
+        }
+
+        for (ii, ((((advice_d, instance_d), permutation), shuffles_inst), lookups_inst)) in advice_d
+            .iter()
+            .zip(instance_d.iter())
+            .zip(permutations.iter())

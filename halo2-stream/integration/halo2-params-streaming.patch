+            let path = e?.path();
+            if path
+                .file_name()
+                .and_then(|n| n.to_str())
+                .is_some_and(|n| n.starts_with("ss_h_") && n.ends_with(".bin"))
+            {
+                let _ = std::fs::remove_file(path);
+            }
+        }
+
+        Ok(Polynomial {
+            values,
+            _marker: std::marker::PhantomData,
+        })
+    }

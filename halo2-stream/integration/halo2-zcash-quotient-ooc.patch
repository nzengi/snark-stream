+    /// Disk-backed twin of [`Self::get_chunk_of_rotated_extended`]: reads the same
+    /// chunk of the rotated polynomial straight from a scratch file holding the
+    /// extended coset as `PrimeField::to_repr` records (`width` bytes each), so the
+    /// coset need not be resident. The rotation is a cyclic shift, so the chunk is a
+    /// contiguous window starting at `(chunk_start + mid) mod extended_len`, wrapped.
+    /// Used by the out-of-core quotient evaluator.
+    pub(crate) fn get_chunk_of_rotated_extended_from_file(
+        &self,
+        file: &std::fs::File,
+        width: usize,
+        rotation: Rotation,
+        chunk_size: usize,
+        chunk_index: usize,
+    ) -> Vec<F> {
+        use std::os::unix::fs::FileExt;
+        let ext_len = self.extended_len();
+        let new_rotation =
+            (1usize << (self.extended_k - self.k)) * rotation.0.unsigned_abs() as usize;
+        // First element of the rotated poly is `original[mid]`.
+        let mid = if rotation.0 >= 0 {
+            new_rotation
+        } else {
+            ext_len - new_rotation
+        };
+        let chunk_start = chunk_size * chunk_index;
+        let chunk_end = ext_len.min(chunk_size * (chunk_index + 1));
+        let chunk_len = chunk_end - chunk_start;
+
+        let mut out = Vec::with_capacity(chunk_len);
+        let mut cur = (chunk_start + mid) % ext_len;
+        let mut remaining = chunk_len;
+        let mut buf = Vec::new();
+        while remaining > 0 {
+            let run = remaining.min(ext_len - cur);
+            buf.resize(run * width, 0u8);
+            file.read_exact_at(&mut buf, (cur * width) as u64)
+                .expect("read coset window");
+            for c in buf.chunks_exact(width) {
+                let mut repr = F::Repr::default();
+                repr.as_mut().copy_from_slice(c);
+                out.push(Option::<F>::from(F::from_repr(repr)).expect("canonical repr"));
+            }
+            remaining -= run;
+            cur += run;
+            if cur == ext_len {
+                cur = 0;
+            }
+        }
+        out
+    }

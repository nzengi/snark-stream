+impl<E, F: WithSmallOrderMulGroup<3>> Evaluator<E, F, ExtendedLagrangeCoeff> {
+    /// Out-of-core twin of [`Evaluator::evaluate`] for the quotient (extended basis).
+    /// Spills each registered coset to a scratch file and reads only the chunk window
+    /// each `Ast::Poly` leaf needs — the same range [`Evaluator::evaluate`] would take,
+    /// with the rotation handled as a cyclic window — so the cosets need not all be
+    /// resident at once. Byte-for-byte identical to `evaluate`; scratch lives in `dir`.
+    pub(crate) fn evaluate_ooc(
+        &self,
+        ast: &Ast<E, F, ExtendedLagrangeCoeff>,
+        domain: &EvaluationDomain<F>,
+        dir: &std::path::Path,
+    ) -> Polynomial<F, ExtendedLagrangeCoeff>
+    where
+        E: Copy + Send + Sync,
+    {
+        use std::os::unix::fs::FileExt;
+
+        let poly_len = self.polys.first().unwrap().len();
+        let (chunk_size, _num_chunks) = get_chunk_params(poly_len);
+        let width = F::Repr::default().as_ref().len();
+
+        // Spill every registered coset to its own scratch file (to_repr records).
+        let files: Vec<std::fs::File> = self
+            .polys
+            .iter()
+            .enumerate()
+            .map(|(i, poly)| {
+                let path = dir.join(format!("zk_ooc_{i}.bin"));
+                let f = std::fs::OpenOptions::new()
+                    .read(true)
+                    .write(true)
+                    .create(true)
+                    .truncate(true)
+                    .open(&path)
+                    .expect("create scratch");
+                let mut buf = vec![0u8; poly.len() * width];
+                for (v, c) in poly.values.iter().zip(buf.chunks_exact_mut(width)) {
+                    c.copy_from_slice(v.to_repr().as_ref());
+                }
+                f.write_all_at(&buf, 0).expect("spill coset");
+                f
+            })
+            .collect();
+
+        struct AstContext<'a, F: Field> {
+            domain: &'a EvaluationDomain<F>,
+            poly_len: usize,
+            chunk_size: usize,
+            chunk_index: usize,
+            files: &'a [std::fs::File],
+            width: usize,
+        }
+
+        fn recurse<E, F: WithSmallOrderMulGroup<3>>(
+            ast: &Ast<E, F, ExtendedLagrangeCoeff>,
+            ctx: &AstContext<'_, F>,
+        ) -> Vec<F> {
+            match ast {
+                Ast::Poly(leaf) => ctx.domain.get_chunk_of_rotated_extended_from_file(
+                    &ctx.files[leaf.index],
+                    ctx.width,
+                    leaf.rotation,
+                    ctx.chunk_size,
+                    ctx.chunk_index,
+                ),
+                Ast::Add(a, b) => {
+                    let mut lhs = recurse(a, ctx);
+                    let rhs = recurse(b, ctx);
+                    for (lhs, rhs) in lhs.iter_mut().zip(rhs.iter()) {
+                        *lhs += *rhs;
+                    }
+                    lhs
+                }
+                Ast::Mul(AstMul(a, b)) => {
+                    let mut lhs = recurse(a, ctx);
+                    let rhs = recurse(b, ctx);
+                    for (lhs, rhs) in lhs.iter_mut().zip(rhs.iter()) {
+                        *lhs *= *rhs;
+                    }
+                    lhs
+                }
+                Ast::Scale(a, scalar) => {
+                    let mut lhs = recurse(a, ctx);
+                    for lhs in lhs.iter_mut() {
+                        *lhs *= scalar;
+                    }
+                    lhs
+                }
+                Ast::DistributePowers(terms, base) => terms.iter().fold(
+                    <ExtendedLagrangeCoeff as BasisOps>::constant_term(
+                        ctx.poly_len,
+                        ctx.chunk_size,
+                        ctx.chunk_index,
+                        F::ZERO,
+                    ),
+                    |mut acc, term| {
+                        let term = recurse(term, ctx);
+                        for (acc, term) in acc.iter_mut().zip(term) {
+                            *acc *= base;
+                            *acc += term;
+                        }
+                        acc
+                    },
+                ),
+                Ast::LinearTerm(scalar) => <ExtendedLagrangeCoeff as BasisOps>::linear_term(
+                    ctx.domain,
+                    ctx.poly_len,
+                    ctx.chunk_size,
+                    ctx.chunk_index,
+                    *scalar,
+                ),
+                Ast::ConstantTerm(scalar) => <ExtendedLagrangeCoeff as BasisOps>::constant_term(
+                    ctx.poly_len,
+                    ctx.chunk_size,
+                    ctx.chunk_index,
+                    *scalar,
+                ),
+            }
+        }
+
+        let mut result = <ExtendedLagrangeCoeff as BasisOps>::empty_poly(domain);
+        multicore::scope(|scope| {
+            for (chunk_index, out) in result.chunks_mut(chunk_size).enumerate() {
+                let files = &files;
+                scope.spawn(move |_| {
+                    let ctx = AstContext {
+                        domain,
+                        poly_len,
+                        chunk_size,
+                        chunk_index,
+                        files,
+                        width,
+                    };
+                    out.copy_from_slice(&recurse(ast, &ctx));
+                });
+            }
+        });
+
+        for i in 0..self.polys.len() {
+            let _ = std::fs::remove_file(dir.join(format!("zk_ooc_{i}.bin")));
+        }
+        result
+    }
+}
